models/

# 运行时截图 / 临时输出
*.png
*.jpg
page.png
page-*.png
webtoon-*.txt
webtoon-ko-zh-*.txt

# 过采样临时集（可由 train.jsonl 再生成）
data/train.oversample.jsonl

# 汉化输出 / 抓取工作目录
out/
*-work/