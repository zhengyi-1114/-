# 环境与隐私（勿提交真实 Key）
.venv/
.cache/
.env
.env.*
!.env.example

# 本地缓存 / 构建产物
__pycache__/
*.py[cod]
*.egg-info/
.dist/
build/
dist/
.pytest_cache/
.mypy_cache/
.gradio/
logs/
.DS_Store

