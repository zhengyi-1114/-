# 翻译后端：google（默认，免 Key）| openai | doubao
TRANSLATOR_BACKEND=google

# —— OpenAI / GPT（也可填兼容接口，如 DeepSeek、通义等）——
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# —— 豆包 / 火山方舟 ——
# 在控制台创建「推理接入点」，把接入点 ID 填到 DOUBAO_MODEL
# DOUBAO_API_KEY=your-ark-api-key
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL=ep-xxxxxxxxxxxxxxxx
